{
  "name": "dsh-workbench-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-CLI bridge plugin for DeepSeek Harness & DSH Go: aggregates Antigravity, Claude Code, and Codex sessions and executes prompts.",
  "author": "AEmbers",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node ../../sdk/plugin-kit/bin/check.mjs . --load"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=22.19",
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  }
}
